# Réglages du serveur Intrigue. Copier dans /etc/intrigue.env, puis : chmod 600 /etc/intrigue.env

# Mot de passe pour ouvrir l'outil (8 caractères au moins). Le changer déconnecte tout le monde.
INTRIGUE_PASSWORD=choisissez-un-mot-de-passe

# Adresse publique de l'outil, telle qu'on la tape dans le navigateur.
INTRIGUE_WEB_URL=https://intrigue.example.fr/

# Dossier où sont rangés les scénarios (un fichier .json par scénario).
INTRIGUE_DIR=/var/lib/intrigue

# Port local, derrière nginx.
PORT=3000
