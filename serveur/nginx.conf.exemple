# Bloc nginx : toute l'adresse est confiée au serveur Intrigue (outil web, API, connecteur).
# Le certificat https peut être obtenu avec : certbot --nginx -d intrigue.example.fr
server {
    server_name intrigue.example.fr;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Mises à jour en direct de la page : pas de mise en tampon, connexion longue.
        proxy_buffering off;
        proxy_read_timeout 1h;
        client_max_body_size 3m;
    }

    listen 80;
}
